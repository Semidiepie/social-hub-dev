{
  "expo": {
    "name": "PostMePlex",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "postmeplex",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "description": "PostMePlex is the social home for gamers, streamers and every clutch moment. Post photos and reels, message your squad, go Live, discover trending creators and tags.",
    "primaryColor": "#FF6B3D",
    "privacy": "public",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.emergent.vibesstream169e45e05",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos and broadcast your live streams",
        "NSPhotoLibraryUsageDescription": "Select photos and videos to share with your squad",
        "NSPhotoLibraryAddUsageDescription": "Save photos and reels you create to your library",
        "NSMicrophoneUsageDescription": "Record audio for reels and live streams",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.postmeplex.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#12141c"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-transparent.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "backgroundColor": "#12141c"
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/adaptive-icon.png",
          "color": "#FF6B3D",
          "sounds": []
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Select photos and videos to share with your squad",
          "cameraPermission": "Capture photos and videos for posts and reels"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Broadcast live streams from your camera",
          "microphonePermission": "Capture audio for your live streams",
          "recordAudioAndroid": true
        }
      ],
      "react-native-compressor"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
